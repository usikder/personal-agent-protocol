{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "checkout-summary.schema.json",
    "title": "Checkout rich summary",
    "description": "The checkout summary style, version 1: a purchase an Operation performs, for rendering beside its required text summary. Cross-field rules (one currency, line and subtotal arithmetic) are in Operations 3.2.",
    "type": "object",
    "required": ["style", "version", "amount_due_now"],
    "additionalProperties": false,
    "properties": {
        "style": { "const": "checkout" },
        "version": { "const": "1" },
        "amount_due_now": { "$ref": "#/$defs/amount" },
        "conditional_charge": {
            "type": "object",
            "required": ["max", "terms"],
            "additionalProperties": false,
            "properties": {
                "max": { "$ref": "#/$defs/amount" },
                "terms": { "$ref": "#/$defs/text" }
            }
        },
        "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/item" }
        },
        "subtotal": { "$ref": "#/$defs/amount" },
        "obligations": {
            "type": "array",
            "items": { "$ref": "#/$defs/obligation" }
        },
        "fulfillment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "destination": { "$ref": "#/$defs/text" },
                "service": { "$ref": "#/$defs/text" },
                "arrival": { "$ref": "#/$defs/text" },
                "pickup_location": { "$ref": "#/$defs/text" }
            }
        },
        "account": { "$ref": "#/$defs/text" },
        "contact": { "$ref": "#/$defs/text" },
        "payment_method": { "$ref": "#/$defs/text" },
        "not_applicable": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["field", "reason"],
                "additionalProperties": false,
                "properties": {
                    "field": { "enum": ["fulfillment", "account", "contact", "payment_method"] },
                    "reason": { "$ref": "#/$defs/text" }
                }
            }
        }
    },
    "$defs": {
        "text": { "type": "string", "minLength": 1 },
        "amount": {
            "description": "A decimal string in the currency's major unit, with . as the decimal point and no digit-grouping separators, and an uppercase ISO 4217 currency code.",
            "type": "object",
            "required": ["amount", "currency"],
            "additionalProperties": false,
            "properties": {
                "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
                "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
            }
        },
        "item": {
            "type": "object",
            "required": ["name", "quantity"],
            "additionalProperties": false,
            "properties": {
                "name": { "$ref": "#/$defs/text" },
                "quantity": { "type": "number", "exclusiveMinimum": 0 },
                "options": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/text" }
                },
                "unit_amount": { "$ref": "#/$defs/amount" },
                "line_total": { "$ref": "#/$defs/amount" },
                "seller": { "$ref": "#/$defs/text" },
                "obligations": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/obligation" }
                }
            }
        },
        "obligation": {
            "type": "object",
            "required": ["kind"],
            "oneOf": [
                {
                    "required": ["kind", "amount", "interval", "terms"],
                    "additionalProperties": false,
                    "properties": {
                        "kind": { "const": "recurring" },
                        "amount": { "$ref": "#/$defs/amount" },
                        "interval": { "$ref": "#/$defs/text" },
                        "terms": { "$ref": "#/$defs/text" }
                    }
                },
                {
                    "required": ["kind", "total", "terms"],
                    "additionalProperties": false,
                    "properties": {
                        "kind": { "const": "financing" },
                        "total": { "$ref": "#/$defs/amount" },
                        "terms": { "$ref": "#/$defs/text" }
                    }
                },
                {
                    "required": ["kind", "terms"],
                    "additionalProperties": false,
                    "properties": {
                        "kind": { "const": "other" },
                        "terms": { "$ref": "#/$defs/text" }
                    }
                }
            ]
        }
    }
}
